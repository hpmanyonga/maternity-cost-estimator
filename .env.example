# Copy to .env for local dev, or set as environment variables on Render

# --- Required ---
SUPABASE_URL=https://zcjodsewjugovlmocgrz.supabase.co
SUPABASE_KEY=your-anon-key-here

# --- Required for admin pages ---
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Required for QuickQuote patient hashing ---
NETWORK_ONE_AUDIT_SALT=generate-a-random-64-char-string

# --- Required for QuickQuote database persistence ---
SUPABASE_DB_PASSWORD=your-db-password-here

# --- Optional: Google Sheets lead capture ---
# Create a service account in Google Cloud Console, enable Sheets + Drive APIs,
# share your spreadsheet with the service account email as Editor.
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...full JSON here..."}
GOOGLE_SHEETS_ID=your-spreadsheet-id-from-url
